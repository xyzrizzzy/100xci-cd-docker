{
  "name": "week-27.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && bunx prisma generate && cd ../..",
    "http-start": "cd apps/http-backend && bun run start",
    "ws-start": "cd apps/ws-backend && bun run start",
    "web-start": "cd apps/web-frontend && bun run start"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.2.21"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "prisma": "7"
  }
}
