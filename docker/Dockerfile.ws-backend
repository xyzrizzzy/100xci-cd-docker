FROM oven/bun:1.4.4

WORKDIR /usr/src/app

COPY ./packages ./packages
COPY ./bun.lock ./
COPY package.json ./
COPY turbo.json ./
COPY apps/http-backend/package.* ./apps/http-backend/package.*

RUN bun install

COPY ./apps/ws-backend ./apps/ws-backend

RUN bun install
RUN bun run db:generate

EXPOSE 8080

CMD ["bun", "run", "ws-start"]