FROM oven/bun:1.4.4

WORKDIR /usr/src/app

ARG DATABASE_URL
COPY ./packages ./packages
COPY ./bun.lock ./
COPY package.json ./
COPY turbo.json ./
COPY apps/http-backend/package.* ./apps/http-backend/package.*

RUN bun install

COPY ./apps/web ./apps/web

RUN bun install
RUN bun run db:generate
RUN DATABASE_URL=${DATABASE_URL} bun run build

EXPOSE 3000

CMD ["bun", "run", "web-start"]